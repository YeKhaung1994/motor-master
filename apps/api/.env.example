# --- Database ---
#
# Either a full connection string, or the discrete fields below. DATABASE_URL
# wins when set, so uncommenting it points every command — dev, migrate, seed —
# at that database instead of the local container.
#
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

DB_HOST=localhost
DB_PORT=5432
DB_NAME=motor_master
DB_USER=motor_master
DB_PASSWORD=motor_master_dev
# TLS: off for the local container, required by Supabase, Neon and RDS.
# Left unset, it defaults to on for a remote host and off for localhost.
DB_SSL=false

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Web ---
VITE_API_URL=/api/v1
