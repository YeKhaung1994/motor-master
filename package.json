{
  "name": "motor-master",
  "private": true,
  "version": "0.1.0",
  "description": "Motorcycle specification and comparison website",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build --workspace @motor-master/share_ui && concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @motor-master/api",
    "dev:web": "npm run dev --workspace @motor-master/web",
    "build": "npm run build --workspace @motor-master/share_ui && npm run build --workspace @motor-master/api && npm run build --workspace @motor-master/web",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e --workspace @motor-master/web",
    "db:migrate": "npm run db:migrate --workspace @motor-master/api",
    "db:seed": "npm run db:seed --workspace @motor-master/api",
    "db:seed:fresh": "npm run db:seed:fresh --workspace @motor-master/api",
    "images:audit": "node tools/audit-images.cjs",
    "storybook": "npm run storybook --workspace @motor-master/share_ui"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
